      "OpenAIVoice": {
        "description": "OpenAI's voice names, accepted so an existing integration works when repointed.",
        "enum": [
          "alloy",
          "echo",
          "fable",
          "onyx",
          "nova",
          "shimmer",
          "ash",
          "ballad",
          "coral",
          "sage",
          "verse"
        ],
        "title": "OpenAIVoice",
        "type": "string"
      },
      "SpeechFormat": {
        "description": "`response_format` on the speech endpoint, and the media type each name is served as.\n\nThe member value stays the plain name a caller sends, so a body parses straight into a\nmember; the media type rides along, which keeps the Content-Type off every call site.",
        "enum": [
          "pcm",
          "wav",
          "mp3",
          "opus",
          "ulaw",
          "alaw",
          "l16_8000",
          "l16_16000",
          "fmp4"
        ],
        "title": "SpeechFormat",
        "type": "string"
      },
      "SpeechRequest": {
        "description": "Body of `POST /openai/v1/audio/speech`.",
        "properties": {
          "djelia": {
            "$ref": "#/components/schemas/DjeliaSpeechOptions",
            "description": "Djelia-specific options with no OpenAI equivalent."
          },
          "input": {
            "description": "The text to synthesise, at most 5000 characters.",
            "examples": [
              "Aw ni ce, i ka kene wa?"
            ],
            "title": "Input",
            "type": "string"
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          },
          "model": {
            "default": "jifili-1",
            "description": "Model id.",
            "title": "Model",
            "type": "string"
          },
          "response_format": {
            "$ref": "#/components/schemas/SpeechFormat",
            "default": "mp3"
          },
          "speed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed"
          },
          "stream_format": {
            "anyOf": [
              {
                "enum": [
                  "audio",
                  "sse"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "audio",
            "description": "`audio` (default) streams raw encoded bytes; `sse` streams base64 audio in `speech.audio.delta` events.",
            "title": "Stream Format"
          },
          "voice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Voice"
              },
              {
                "$ref": "#/components/schemas/OpenAIVoice"
              }
            ],
            "default": "moussa",
            "description": "Voice name. Djelia voices are `moussa`, `sekou` and `seydou`; the OpenAI voice names are accepted as aliases.",
            "title": "Voice"
          }
        },
        "required": [
          "input"
        ],
        "title": "SpeechRequest",
        "type": "object"
      },
