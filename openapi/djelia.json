                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            },
            "description": "Unknown model or endpoint"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "Bearer token": []
